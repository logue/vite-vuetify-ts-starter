{
  "name": "vite-vuetify-ts-starter",
  "version": "2.4.1",
  "private": true,
  "description": "Vue3 Vuetify TypeScript Starter project for Vite.",
  "homepage": "https://github.com/logue/vite-vuetify-ts-starter",
  "bugs": {
    "url": "https://github.com/logue/vite-vuetify-ts-starter/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:logue/vite-vuetify-ts-starter.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint --fix",
    "lint:oxfmt": "oxfmt",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:analyze": "vite build --mode analyze",
    "build:clean": "rimraf dist",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "clean": "rimraf dist",
    "clean:hard": "rimraf dist node_modules/.tmp node_modules/.vite node_modules/.vite-tmp",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "skills:update": "npx skills update"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "core-js": "^3.50.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "resize-observer-polyfill": "^1.5.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vuetify": "^4.2.3"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@playwright/test": "^1.63.0",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.2",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-vuetify": "^2.7.3",
    "jsdom": "^30.1.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass-embedded": "^1.105.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.2",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "packageManager": "pnpm@12.8.1",
  "stackblitz": {
    "startCommand": "pnpm run test:unit"
  }
}